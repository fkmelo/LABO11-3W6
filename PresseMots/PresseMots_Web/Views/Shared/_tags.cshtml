@model PresseMots.Models.Story

@foreach (var item in @Model.StoryTags)
{
    <span class="badge badge-secondary">
        @item.Tag.Name    &nbsp;&nbsp;
        <a class="badge badge-danger badge-pill" asp-action="Delete" asp-controller="StoryTag" asp-route-id="@Model.StoryTags" >&nbsp;×&nbsp;</a>
    </span>

}